---
import { footerLinks, navigationItems } from '../data/navigation';
import { site } from '../data/site';

const year = new Date().getFullYear();
const opensInNewTab = (item: { href: string; externalDestination?: boolean }) =>
    item.externalDestination || item.href.startsWith('http');
const footerNavigationItems = navigationItems;
---

<footer class="footer">
    <div class="footer-content">
        <div class="footer-identity">
            <div>
                <p class="footer-label">END // INDEX</p>
                <h2>{site.name}</h2>
            </div>
            <p>Backend systems, infrastructure tools, and open source work.</p>
        </div>

        <div class="footer-links">
            <nav aria-label="Footer navigation">
                {footerNavigationItems.map((item) => (
                    <a
                        class="footer-link scramble-link"
                        href={item.href}
                        target={opensInNewTab(item) ? '_blank' : undefined}
                        rel={opensInNewTab(item) ? 'noreferrer' : undefined}
                    >
                        <span class="scramble-link-label" data-scramble-text>{item.label}</span>
                    </a>
                ))}
            </nav>

            <nav aria-label="Social links">
                {footerLinks.map((item) => (
                    <a
                        class="footer-link scramble-link"
                        href={item.href}
                        target={opensInNewTab(item) ? '_blank' : undefined}
                        rel={opensInNewTab(item) ? 'noreferrer' : undefined}
                    >
                        <span class="scramble-link-label" data-scramble-text>{item.label}</span>
                    </a>
                ))}
            </nav>
        </div>

        <div class="footer-meta">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <span>{year} // Nigeria</span>
        </div>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--color-border);
        background:
            radial-gradient(circle at 12% 100%, color-mix(in srgb, var(--color-primary) 5%, transparent), transparent 24rem),
            var(--color-surface);
        padding: 4rem 1.5rem 2rem;
        color: var(--color-text);
    }

    .footer-content {
        width: min(100%, 72rem);
        margin-inline: auto;
    }

    .footer-identity {
        display: grid;
        gap: 1.5rem;
        padding-bottom: 3rem;
    }

    .footer-label,
    .footer-meta {
        color: var(--color-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .footer-label { margin-bottom: 0.85rem; color: var(--color-accent); }

    .footer h2 {
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .footer-identity > p {
        max-width: 31rem;
        color: var(--color-muted);
        line-height: 1.7;
    }

    .footer-links {
        display: grid;
        gap: 1.5rem;
        border-block: 1px solid var(--color-border);
        padding-block: 1.5rem;
    }

    .footer-links nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 1.5rem;
    }

    .footer-link {
        color: var(--color-muted);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 180ms ease-out;
    }

    .footer-link:hover,
    .footer-link:focus-visible { color: var(--color-primary); outline: none; }

    .footer-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.5rem;
    }

    .footer-meta a { color: var(--color-primary); text-decoration: none; }

    @media (min-width: 800px) {
        .footer { padding: 5rem 2.5rem 2.5rem; }
        .footer-identity { grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.5fr); align-items: end; }
        .footer-links { grid-template-columns: 1fr auto; }
        .footer-links nav:last-child { justify-content: flex-end; }
    }
</style>

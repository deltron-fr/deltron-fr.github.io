---
import MobileMenu from './MobileMenu.astro';
import { navigationItems } from '../data/navigation';
import { site } from '../data/site';

type Props = { hideOnScroll?: boolean };
const { hideOnScroll = false } = Astro.props;
---

<header class="site-header" data-hide-on-scroll={hideOnScroll ? 'true' : undefined}>
    <div class="header-frame">
        <a class="header-brand" href="/" aria-label={`${site.name} home`}>
            <span class="brand-mark" aria-hidden="true">KO</span>
            <span class="brand-name">{site.name}</span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
            {navigationItems.map((item) => (
                <a class="nav-link" href={item.href}>{item.label}</a>
            ))}
        </nav>

        <a class="availability" href="/#contact">
            <span class="availability-dot" aria-hidden="true"></span>
            Available
        </a>

        <MobileMenu />
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 110;
        height: 4.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
        background: color-mix(in srgb, var(--color-background) 82%, transparent);
        color: var(--color-text);
        backdrop-filter: blur(18px);
        transition: transform 260ms ease-out, background 180ms ease-out;
    }

    .site-header.is-hidden { transform: translateY(-100%); }

    .header-frame {
        display: flex;
        width: min(100%, 80rem);
        height: 100%;
        align-items: center;
        margin-inline: auto;
        padding-inline: 1.25rem;
    }

    .header-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: inherit;
        text-decoration: none;
    }

    .brand-mark {
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        place-items: center;
        border: 1px solid color-mix(in srgb, var(--color-primary) 55%, var(--color-border));
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
    }

    .brand-name {
        font-size: 0.9rem;
        font-weight: 650;
        letter-spacing: 0.08em;
    }

    .desktop-nav,
    .availability { display: none; }

    :global(.mobile-menu-root) { margin-left: auto; }

    @media (min-width: 800px) {
        .site-header { height: 5rem; }
        .header-frame { padding-inline: 2rem; }

        .desktop-nav {
            display: flex;
            align-items: center;
            gap: 1.75rem;
            margin-left: auto;
        }

        .nav-link {
            position: relative;
            color: var(--color-muted);
            font-size: 0.84rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-decoration: none;
            transition: color 180ms ease-out;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            right: 0;
            bottom: -0.55rem;
            left: 0;
            height: 1px;
            background: var(--color-primary);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 180ms ease-out;
        }

        .nav-link:hover,
        .nav-link:focus-visible { color: var(--color-text); outline: none; }
        .nav-link:hover::after,
        .nav-link:focus-visible::after { transform: scaleX(1); }

        .availability {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            margin-left: 2rem;
            border: 1px solid var(--color-border);
            padding: 0.55rem 0.75rem;
            color: var(--color-muted);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-decoration: none;
            text-transform: uppercase;
            transition: border-color 180ms ease-out, color 180ms ease-out;
        }

        .availability:hover,
        .availability:focus-visible {
            border-color: color-mix(in srgb, var(--color-primary) 60%, var(--color-border));
            color: var(--color-text);
            outline: none;
        }

        .availability-dot {
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 50%;
            background: var(--color-primary);
            box-shadow: 0 0 0.45rem color-mix(in srgb, var(--color-primary) 38%, transparent);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .site-header,
        .nav-link::after { transition: none; }
    }
</style>

<script>
    const header = document.querySelector('[data-hide-on-scroll="true"]');

    if (header instanceof HTMLElement) {
        let lastScrollY = window.scrollY;
        const updateHeaderVisibility = () => {
            const currentScrollY = Math.max(window.scrollY, 0);
            const delta = currentScrollY - lastScrollY;
            if (currentScrollY <= 8) header.classList.remove('is-hidden');
            else if (Math.abs(delta) >= 12) header.classList.toggle('is-hidden', delta > 0);
            if (Math.abs(delta) >= 12 || currentScrollY <= 8) lastScrollY = currentScrollY;
        };

        window.addEventListener('scroll', updateHeaderVisibility, { passive: true });
        window.addEventListener('pagehide', () => window.removeEventListener('scroll', updateHeaderVisibility), { once: true });
    }
</script>

---
import IcBaselineDiscord from '~icons/ic/baseline-discord';
import IcSharpEmail from '~icons/ic/sharp-email';
import MdiArrowTopRight from '~icons/mdi/arrow-top-right';
import MdiConsoleLine from '~icons/mdi/console-line';
import MdiFileDocument from '~icons/mdi/file-document';
import MdiGithub from '~icons/mdi/github';
import MdiSourceBranch from '~icons/mdi/source-branch';
import MdiWeb from '~icons/mdi/web';
import SignalFieldBackground from '../components/SignalFieldBackground.astro';
import { about } from '../data/about';
import { contact } from '../data/contact';
import { hero } from '../data/hero';
import { site } from '../data/site';
import { work } from '../data/work';
import Layout from '../layouts/Layout.astro';
import { absoluteAssetUrl, absoluteUrl } from '../lib/seo';

const interestIconMap = {
    openSource: MdiSourceBranch,
    terminal: MdiConsoleLine,
    web: MdiWeb,
};

const contactIconMap = {
    Email: IcSharpEmail,
    GitHub: MdiGithub,
    Discord: IcBaselineDiscord,
};

type WorkItem = (typeof work.work)[number];
type ContactChannel = (typeof contact.channels)[number];
type ResumeOption = (typeof contact.resume.options)[number];

const homeJsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: absoluteUrl('/'),
        description: site.description,
        inLanguage: site.language,
        publisher: {
            '@type': 'Person',
            name: site.author,
            url: absoluteUrl('/'),
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.author,
        url: absoluteUrl('/'),
        email: site.email,
        image: absoluteAssetUrl(site.defaultOgImage),
        sameAs: [site.social.github],
        knowsAbout: ['Backend development', 'Systems engineering', 'Infrastructure', 'Go', 'Python', 'Open source'],
    },
];
const homeTitle = 'Kelechi Ogbonnaya | Systems & Backend Engineer';
---

<Layout
    title={homeTitle}
    description={site.description}
    canonicalPath="/"
    image={site.defaultOgImage}
    imageAlt="Kelechi Ogbonnaya systems and backend engineer social image"
    jsonLd={homeJsonLd}
>
    <section class="hero-section relative isolate overflow-hidden px-6 sm:px-10">
        <SignalFieldBackground />

        <div class="hero-content relative z-10 flex items-center">
            <div class="hero-shell">
                <div class="hero-copy">
                    <p class="hero-command" data-hero-reveal>
                        <span class="text-muted">~/portfolio</span>
                        <span class="text-accent">$</span>
                        <span>whoami</span>
                    </p>

                    <div class="hero-availability" data-hero-reveal>
                        <span class="hero-status-dot" aria-hidden="true"></span>
                        {hero.availability}
                    </div>

                    <h1 class="hero-title" data-hero-reveal>{hero.name}</h1>
                    <p class="hero-role" data-hero-reveal>{hero.headline}</p>
                    <p class="hero-summary" data-hero-reveal>{hero.summary}</p>

                    <div class="hero-actions" data-hero-reveal>
                        <a class="hero-primary-action" href="#my-work">View my work</a>
                        <a class="hero-secondary-action" href="/resume/">View resume</a>
                    </div>
                </div>

                <dl class="hero-readout" data-hero-reveal>
                    <div><dt>LOC</dt><dd>{hero.location}</dd></div>
                    <div><dt>FOCUS</dt><dd>Systems + Backend</dd></div>
                    <div><dt>STACK</dt><dd>Go + Python</dd></div>
                </dl>
            </div>
        </div>
    </section>

    <section class="home-section border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="about" data-reveal-section>
        <div class="home-content flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
            <div class="space-y-5 lg:max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>{about.heading}</span>
                </h2>
            </div>
            <div class="space-y-8 text-text lg:max-w-2xl">
                <div class="space-y-5 text-lg leading-8 text-text/80">
                    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>

                <div class="interest-list flex flex-wrap gap-3 text-sm uppercase tracking-[0.12em] text-text">
                    {about.interests.map((interest) => (
                        <div class="interest-item">
                            {(() => {
                                const Icon = interestIconMap[interest.icon];

                                return (
                                    <span class="text-lg text-primary">
                                        <Icon aria-hidden="true" />
                                    </span>
                                );
                            })()}
                            <span>{interest.label}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="home-section border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="my-work" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>{work.heading}</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <p class="text-lg leading-8 text-text/80">
                    {work.intro}
                </p>

                <div class="work-list-frame grid border border-border bg-surface">
                    {work.work.map((item: WorkItem) => (
                        <article class="work-reveal-row bg-surface text-text" data-work-reveal>
                            <div class="space-y-4 px-5 pt-5">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="font-mono text-sm text-primary">
                                        {item.id}
                                    </div>

                                    <span class="inline-flex shrink-0 border border-primary px-2 py-1 text-xs uppercase tracking-[0.14em] text-primary">
                                        {item.status}
                                    </span>
                                </div>

                                <div class="flex flex-wrap items-center gap-3">
                                    <h3 class="text-xl font-bold text-text">
                                        {'href' in item ? (
                                            <a
                                                class="group inline-flex items-center gap-2 underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary focus-visible:text-primary focus-visible:decoration-primary focus-visible:outline-none"
                                                href={item.href}
                                                target={item.href.startsWith('http') ? '_blank' : undefined}
                                                rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                                            >
                                                <span>{item.title}</span>
                                                <MdiArrowTopRight
                                                    class="shrink-0 text-base text-primary transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-focus-visible:-translate-y-0.5 group-focus-visible:translate-x-0.5"
                                                    aria-hidden="true"
                                                />
                                            </a>
                                        ) : (
                                            item.title
                                        )}
                                    </h3>
                                </div>
                            </div>

                            <div class="px-5 pb-5">
                                <p class="text-base leading-7 text-text/70">
                                    {item.description}
                                </p>

                                <div class="mt-5 flex flex-wrap gap-2">
                                    {item.tags.map((tag: string) => (
                                        <span class="border border-border px-2 py-1 font-mono text-xs uppercase tracking-[0.12em] text-text/60">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="home-section border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="resume" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>RESUME</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <p class="max-w-2xl text-lg leading-8 text-text/80">
                    {contact.resume.intro}
                </p>

                <div class="grid gap-px border border-border bg-border">
                    {contact.resume.options.map((resume: ResumeOption) => (
                        <a
                            class="resume-card group relative isolate overflow-hidden bg-surface p-6 text-text no-underline transition-colors focus-visible:outline-none sm:p-8"
                            href={resume.href}
                        >
                            <span class="resume-card-logo" aria-hidden="true">
                                <MdiFileDocument />
                            </span>

                            <div class="relative z-10 space-y-5">
                                <div class="font-mono text-sm uppercase tracking-[0.14em] text-primary">
                                    View HTML resume
                                </div>
                                <h3 class="max-w-sm text-3xl font-bold uppercase text-current sm:text-4xl">
                                    {resume.title}
                                </h3>
                                <p class="max-w-md text-base leading-7 text-text/70 transition-colors group-hover:text-text/80 group-focus-visible:text-text/80">
                                    {resume.description}
                                </p>
                                <span class="inline-flex border border-border px-3 py-2 font-mono text-sm text-primary transition-colors group-hover:border-primary group-focus-visible:border-primary">
                                    Open resume
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="home-section border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="contact" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>{contact.heading}</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <p class="text-lg leading-8 text-text/80">
                    {contact.intro}
                </p>

                <div class="grid gap-px border border-border bg-border lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)]">
                    <a
                        class="contact-cta group relative isolate grid min-h-72 overflow-hidden bg-surface p-6 text-text no-underline transition-colors focus-visible:outline-none sm:p-8 lg:grid-cols-[7rem_1fr] lg:gap-5"
                        href={contact.cta.href}
                    >
                        <span class="contact-cta-logo" aria-hidden="true">
                            <MdiFileDocument />
                        </span>

                        <div class="relative z-10 font-mono text-sm uppercase tracking-[0.14em] text-primary transition-colors">
                            /{contact.cta.label}
                        </div>

                        <div class="relative z-10 mt-8 space-y-5 lg:mt-0">
                            <h3 class="max-w-xl text-4xl font-bold uppercase text-current transition-colors sm:text-5xl">
                                {contact.cta.title}
                            </h3>
                            <p class="max-w-xl text-lg leading-8 text-text/70 transition-colors group-hover:text-text/80 group-focus-visible:text-text/80">
                                {contact.cta.description}
                            </p>
                            <div class="inline-flex border border-border px-3 py-2 font-mono text-sm text-primary transition-colors group-hover:border-primary group-focus-visible:border-primary">
                                Email me
                            </div>
                        </div>
                    </a>

                    <div class="grid gap-px bg-border">
                        {contact.channels.map((item: ContactChannel) => {
                            const Icon = contactIconMap[item.label];

                            return (
                                <a
                                    class="contact-channel group relative isolate overflow-hidden bg-surface p-5 text-text no-underline transition-colors focus-visible:outline-none sm:p-6"
                                    href={item.href}
                                    target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                                    rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}
                                >
                                    <span class="contact-channel-logo" aria-hidden="true">
                                        <Icon />
                                    </span>

                                    <div class="relative z-10 flex items-center justify-between gap-6">
                                        <div class="flex flex-wrap items-center gap-3">
                                            <h3 class="text-xl font-bold text-current transition-colors">
                                                {item.label}
                                            </h3>
                                            <span class="font-mono text-sm text-primary transition-colors">
                                                {item.value}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>


<style>
    .home-content,
    .hero-shell {
        width: 100%;
        max-width: 72rem;
        margin-inline: auto;
    }

    .home-section {
        position: relative;
        background:
            linear-gradient(110deg, color-mix(in srgb, var(--color-primary) 2.5%, transparent), transparent 42%),
            var(--color-background);
    }

    .home-section:nth-of-type(odd) {
        background:
            linear-gradient(290deg, color-mix(in srgb, var(--color-primary) 3.5%, transparent), transparent 45%),
            color-mix(in srgb, var(--color-surface) 42%, var(--color-background));
    }

    .hero-section {
        min-height: calc(100svh - 4.5rem);
    }

    .hero-content {
        min-height: calc(100svh - 4.5rem);
        padding-block: 4rem;
    }

    .hero-shell {
        display: grid;
        align-items: end;
        gap: 2.5rem;
    }

    .hero-copy {
        max-width: 48rem;
        border-left: 1px solid color-mix(in srgb, var(--color-primary) 65%, var(--color-border));
        padding: 1.5rem 0 1.5rem clamp(1.25rem, 4vw, 3rem);
        background: linear-gradient(90deg, color-mix(in srgb, var(--color-background) 76%, transparent), transparent);
    }

    .hero-command,
    .hero-availability,
    .hero-readout {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .hero-command {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2.25rem;
        color: var(--color-text);
    }

    .hero-availability {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        color: var(--color-muted);
    }

    .hero-status-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 0.5rem color-mix(in srgb, var(--color-primary) 36%, transparent);
    }

    .hero-title {
        max-width: 12ch;
        font-size: clamp(3rem, 8vw, 6.75rem);
        font-weight: 650;
        letter-spacing: -0.045em;
        line-height: 0.92;
        text-wrap: balance;
    }

    .hero-role {
        margin-top: 1.25rem;
        color: var(--color-primary);
        font-size: clamp(1.25rem, 3vw, 2rem);
        font-weight: 500;
        letter-spacing: -0.015em;
    }

    .hero-summary {
        max-width: 42rem;
        margin-top: 1.25rem;
        color: var(--color-muted);
        font-size: clamp(1rem, 2vw, 1.16rem);
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .hero-primary-action,
    .hero-secondary-action {
        display: inline-flex;
        min-height: 2.8rem;
        align-items: center;
        border: 1px solid var(--color-border);
        padding-inline: 1rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        transition: border-color 180ms ease-out, background 180ms ease-out, color 180ms ease-out;
    }

    .hero-primary-action {
        border-color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        color: var(--color-primary);
    }

    .hero-secondary-action { color: var(--color-text); }

    .hero-primary-action:hover,
    .hero-primary-action:focus-visible,
    .hero-secondary-action:hover,
    .hero-secondary-action:focus-visible {
        border-color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 18%, var(--color-surface));
        color: var(--color-text);
        outline: none;
    }

    .hero-readout {
        display: grid;
        width: min(100%, 46rem);
        border: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-surface) 82%, transparent);
        backdrop-filter: blur(12px);
    }

    .hero-readout > div {
        display: grid;
        grid-template-columns: 5rem 1fr;
        gap: 1rem;
        padding: 0.8rem 1rem;
        border-top: 1px solid var(--color-border);
    }

    .hero-readout > div:first-child { border-top: 0; }
    .hero-readout dt { color: var(--color-accent); }
    .hero-readout dd { color: var(--color-muted); }

    [data-hero-reveal] {
        opacity: 0;
        animation: hero-reveal 560ms ease-out forwards;
    }

    [data-hero-reveal]:nth-child(2) { animation-delay: 80ms; }
    [data-hero-reveal]:nth-child(3) { animation-delay: 150ms; }
    [data-hero-reveal]:nth-child(4) { animation-delay: 220ms; }
    [data-hero-reveal]:nth-child(5) { animation-delay: 290ms; }
    [data-hero-reveal]:nth-child(6) { animation-delay: 360ms; }
    .hero-readout[data-hero-reveal] { animation-delay: 420ms; }

    .interest-item {
        display: inline-flex;
        min-height: 3rem;
        align-items: center;
        gap: 0.7rem;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        padding-inline: 0.9rem;
    }

    .contact-cta,
    .resume-card,
    .contact-channel {
        transition: background 180ms ease-out, color 180ms ease-out, border-color 180ms ease-out;
    }

    .contact-cta:hover,
    .contact-cta:focus-visible,
    .resume-card:hover,
    .resume-card:focus-visible,
    .contact-channel:hover,
    .contact-channel:focus-visible {
        background: var(--color-surface-raised);
        color: var(--color-text);
        outline: none;
    }

    .contact-cta-logo,
    .resume-card-logo,
    .contact-channel-logo {
        position: absolute;
        z-index: 0;
        color: var(--color-primary);
        line-height: 1;
        opacity: 0;
        pointer-events: none;
        transition: opacity 320ms ease-out, transform 320ms ease-out;
    }

    .contact-cta-logo,
    .resume-card-logo {
        right: 1.5rem;
        bottom: -1rem;
        font-size: 12rem;
        transform: translateX(1rem) rotate(-8deg);
    }

    .resume-card-logo { font-size: 10rem; }

    .contact-channel-logo {
        top: 50%;
        right: 1.5rem;
        font-size: 7rem;
        transform: translateY(-50%) translateX(1rem);
    }

    .contact-cta:hover .contact-cta-logo,
    .contact-cta:focus-visible .contact-cta-logo,
    .resume-card:hover .resume-card-logo,
    .resume-card:focus-visible .resume-card-logo,
    .contact-channel:hover .contact-channel-logo,
    .contact-channel:focus-visible .contact-channel-logo {
        opacity: 0.1;
        transform: translateX(0) rotate(-8deg);
    }

    .contact-channel:hover .contact-channel-logo,
    .contact-channel:focus-visible .contact-channel-logo {
        transform: translateY(-50%) translateX(0);
    }

    .about-reveal {
        position: relative;
        display: block;
        width: fit-content;
        padding-left: 1rem;
        color: var(--color-text);
        opacity: 0;
        transform: translateY(1rem);
        transition:
            opacity 420ms ease-out var(--about-reveal-delay, 0ms),
            transform 420ms ease-out var(--about-reveal-delay, 0ms);
    }

    .about-reveal::before {
        content: "";
        position: absolute;
        top: 0.08em;
        bottom: 0.08em;
        left: 0;
        width: 2px;
        background: var(--color-primary);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 420ms ease-out var(--about-reveal-delay, 0ms);
    }

    .about-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .about-reveal.is-visible::before { transform: scaleY(1); }

    .work-list-frame {
        overflow-x: hidden;
        overflow-x: clip;
    }

    .work-reveal-row {
        border-top: 1px solid var(--color-border);
        opacity: 0;
        transform: translateY(1.25rem);
        transition: background 180ms ease-out, border-color 180ms ease-out;
    }

    .work-reveal-row:first-child { border-top: 0; }

    .work-reveal-row:hover,
    .work-reveal-row:focus-within {
        border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
        background:
            radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 24rem),
            var(--color-surface-raised);
    }

    @media (min-width: 800px) {
        .hero-section,
        .hero-content { min-height: calc(100svh - 5rem); }

        .hero-shell {
            grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.48fr);
            gap: 4rem;
        }

        .hero-readout { margin-bottom: 1.5rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }

        [data-hero-reveal],
        .about-reveal,
        .about-reveal::before {
            opacity: 1;
            transform: none;
            animation: none;
            transition: none;
        }

        .work-reveal-row {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes hero-reveal {
        from { opacity: 0; transform: translateY(1rem); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>


<script>
    import { animate, onScroll } from 'animejs';

    const revealSections = document.querySelectorAll('[data-reveal-section]');
    const workRevealItems = document.querySelectorAll('[data-work-reveal]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    revealSections.forEach((section) => {
        const revealItems = section.querySelectorAll('[data-section-reveal]');
        if (!(section instanceof HTMLElement) || !revealItems.length) return;

        const showRevealItems = () => {
            revealItems.forEach((item) => item.classList.add('is-visible'));
        };

        if (reduceMotion) {
            showRevealItems();
        } else if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    showRevealItems();
                    observer.disconnect();
                }
            }, { threshold: 0.3 });
            observer.observe(section);
        } else {
            showRevealItems();
        }
    });

    if (reduceMotion) {
        workRevealItems.forEach((item) => {
            if (item instanceof HTMLElement) {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0rem)';
            }
        });
    } else {
        workRevealItems.forEach((item) => {
            if (!(item instanceof HTMLElement)) return;

            animate(item, {
                y: ['1.25rem', '0rem'],
                opacity: 1,
                duration: 420,
                ease: 'out(3)',
                autoplay: onScroll({
                    target: item,
                    enter: { target: 'top', container: '65%' },
                    leave: { target: 'bottom', container: 'top' },
                    repeat: false,
                }),
            });
        });
    }
</script>
